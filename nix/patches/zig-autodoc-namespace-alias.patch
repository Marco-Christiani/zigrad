+        // Keep feature-gated imported namespaces traversable in autodoc.
+        fn is_empty_namespace(file_index: File.Index, category: Category) bool {
+            const node = switch (category) {
+                .namespace => |node| node,
+                else => return false,
+            };
+            var buf: [2]Ast.Node.Index = undefined;
+            const container_decl = file_index.get_ast().fullContainerDecl(&buf, node) orelse return false;
+            return container_decl.ast.members.len == 0;
+        }
