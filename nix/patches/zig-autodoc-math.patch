+    fn parseMathEscaped(ip: *InlineParser) !void {
+        // Preserve escaped TeX delimiters for client-side math rendering.
+        const opener_start = ip.pos;
+        const content_start = opener_start + 2;
+        const closer_start = mem.indexOfPos(u8, ip.content, content_start, "\\)") orelse return;
+        try ip.addMath(opener_start, content_start, closer_start, closer_start + 2, .math_inline);
+    }
+
+    fn parseMathDollar(ip: *InlineParser) !void {
+        // Accept single-dollar inline and double-dollar display math spans.
+        const opener_start = ip.pos;
+        const display = ip.pos + 1 < ip.content.len and ip.content[ip.pos + 1] == '$';
+        const opener_len: usize = if (display) 2 else 1;
+        const content_start = opener_start + opener_len;
+
+        var search_start = content_start;
+        while (mem.indexOfScalarPos(u8, ip.content, search_start, '$')) |closer_start| {
+            if (display) {
+                if (closer_start + 1 < ip.content.len and ip.content[closer_start + 1] == '$') {
+                    try ip.addMath(opener_start, content_start, closer_start, closer_start + 2, .math_display);
+                    return;
+                }
+            } else if (closer_start == 0 or ip.content[closer_start - 1] != '\\') {
+                try ip.addMath(opener_start, content_start, closer_start, closer_start + 1, .math_inline);
+                return;
+            }
+            search_start = closer_start + 1;
+        }
+    }
+
+    // Store the math body without delimiters so each renderer can emit its syntax.
+    fn addMath(
+        ip: *InlineParser,
+        opener_start: usize,
+        content_start: usize,
+        closer_start: usize,
+        closer_end: usize,
+        tag: Node.Tag,
+    ) !void {
+        const math = try ip.parent.addNode(.{
+            .tag = tag,
+            .data = .{ .text = .{
+                .content = try ip.parent.addString(ip.content[content_start..closer_start]),
+            } },
+        });
+        try ip.completed_inlines.append(ip.parent.allocator, .{
+            .node = math,
+            .start = opener_start,
+            .len = closer_end - opener_start,
+        });
+        ip.pos = closer_end - 1;
+    }
