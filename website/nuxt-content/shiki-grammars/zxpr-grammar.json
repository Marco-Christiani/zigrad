{
  "name": "ZXPR",
  "scopeName": "source.zxpr",
  "fileTypes": [
    "zxpr"
  ],
  "patterns": [
    {
      "include": "#entry_header"
    },
    {
      "include": "#function_header"
    },
    {
      "include": "#region_line"
    },
    {
      "include": "#section_comment"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#binding"
    },
    {
      "include": "#type_annotation"
    },
    {
      "include": "#attribute_list"
    },
    {
      "include": "#number"
    },
    {
      "include": "#variable_ref"
    }
  ],
  "repository": {
    "entry_header": {
      "match": "^(\\s*)(entry)(\\s*:\\s*)([A-Za-z_][\\w-]*)\\b",
      "captures": {
        "2": {
          "name": "keyword.other.zxpr"
        },
        "3": {
          "name": "punctuation.separator.key-value.zxpr"
        },
        "4": {
          "name": "entity.name.function.zxpr"
        }
      }
    },
    "function_header": {
      "match": "^(\\s*)(zxpr)(\\s+)([A-Za-z_][\\w-]*)(\\s*)(\\{)",
      "captures": {
        "2": {
          "name": "keyword.control.zxpr"
        },
        "4": {
          "name": "entity.name.function.zxpr"
        },
        "6": {
          "name": "punctuation.section.block.begin.zxpr"
        }
      }
    },
    "region_line": {
      "patterns": [
        {
          "match": "^(\\s*)([>\\u250c])(\\s*)([A-Za-z_][\\w-]*)(\\[[^\\]]*\\])?",
          "captures": {
            "2": {
              "name": "punctuation.definition.region.begin.zxpr"
            },
            "4": {
              "name": "entity.name.section.zxpr"
            },
            "5": {
              "patterns": [
                {
                  "include": "#attribute_list"
                }
              ]
            }
          }
        },
        {
          "match": "^(\\s*)([<\\u2514])\\s*$",
          "captures": {
            "2": {
              "name": "punctuation.definition.region.end.zxpr"
            }
          }
        },
        {
          "match": "^(\\s*)([|\\u2502])(?=\\s)",
          "captures": {
            "2": {
              "name": "punctuation.definition.region.gutter.zxpr"
            }
          }
        }
      ]
    },
    "section_comment": {
      "match": "(;\\s*)(params|body)\\b(\\s*\\([^)]*\\))?",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.zxpr"
        },
        "2": {
          "name": "entity.name.section.zxpr"
        },
        "3": {
          "name": "comment.line.semicolon.zxpr"
        }
      }
    },
    "comment": {
      "match": ";.*$",
      "name": "comment.line.semicolon.zxpr"
    },
    "string": {
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.zxpr"
        }
      },
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.zxpr"
        }
      ],
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.zxpr"
        }
      },
      "name": "string.quoted.double.zxpr"
    },
    "keyword": {
      "match": "\\b(zxpr|let|in)\\b",
      "name": "keyword.control.zxpr"
    },
    "binding": {
      "patterns": [
        {
          "match": "^(\\s*)([a-z][a-z]*)(\\s*)(:)",
          "captures": {
            "2": {
              "name": "variable.other.readwrite.zxpr"
            },
            "4": {
              "name": "punctuation.separator.type.zxpr"
            }
          }
        },
        {
          "match": "(\\b[a-z][a-z]*\\b)(\\s*:\\s*)(?=[^\\n=]+\\=)",
          "captures": {
            "1": {
              "name": "variable.other.readwrite.zxpr"
            },
            "2": {
              "name": "punctuation.separator.type.zxpr"
            }
          }
        },
        {
          "match": "(=\\s*)([A-Za-z_][\\w-]*)(?=\\[|\\()",
          "captures": {
            "1": {
              "name": "keyword.operator.assignment.zxpr"
            },
            "2": {
              "name": "entity.name.function.zxpr"
            }
          }
        },
        {
          "match": "(\\bin\\b\\s+)([a-z][a-z]*\\b(?:\\s*,\\s*[a-z][a-z]*\\b)*)",
          "captures": {
            "1": {
              "name": "keyword.control.zxpr"
            },
            "2": {
              "patterns": [
                {
                  "include": "#variable_ref"
                }
              ]
            }
          }
        }
      ]
    },
    "type_annotation": {
      "patterns": [
        {
          "match": "\\b\\d+(?:x\\d+)*(?=<)",
          "name": "constant.numeric.zxpr"
        },
        {
          "match": "<([A-Za-z_][\\w]*)>",
          "captures": {
            "0": {
              "name": "storage.type.zxpr"
            },
            "1": {
              "name": "storage.type.zxpr"
            }
          }
        }
      ]
    },
    "attribute_list": {
      "begin": "\\[",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.brackets.begin.zxpr"
        }
      },
      "patterns": [
        {
          "match": "\\b([A-Za-z_][\\w-]*)(\\s*=)",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.zxpr"
            },
            "2": {
              "name": "keyword.operator.assignment.zxpr"
            }
          }
        },
        {
          "include": "#string"
        },
        {
          "include": "#number"
        }
      ],
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.brackets.end.zxpr"
        }
      },
      "name": "meta.annotation.zxpr"
    },
    "number": {
      "patterns": [
        {
          "match": "\\b-?\\d+\\.\\d+\\b",
          "name": "constant.numeric.float.zxpr"
        },
        {
          "match": "\\b-?\\d+\\b",
          "name": "constant.numeric.integer.zxpr"
        }
      ]
    },
    "variable_ref": {
      "match": "\\b[a-z][a-z]*\\b",
      "name": "variable.other.readwrite.zxpr"
    }
  }
}
